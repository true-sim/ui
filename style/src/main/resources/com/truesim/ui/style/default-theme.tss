// The toolkit's default theme: a neutral, quiet dark game HUD. It is an ordinary style sheet, loaded like any other,
// so everything presentational in the toolkit is styled here and a theme replaces all of it.
//
// Element types: panel, label, image, layer (the root of a UI layer: layer#popup, layer#modal...). Style names
// (inherited by children that have none): hud (the HUD's root), card (a raised group), title, value, caption (text
// roles), primary, danger (emphasis), meter (a bar and its fill). States: hover, pressed, focused, focus-visible
// (focus from keys or a gamepad: the focus ring), disabled, drop-target (accepts what is dragged over it), dragging.

@use "tokens";
@use "mixins" as *;
@import "data";
@use "basic"; // the basic and container controls of ui-controls
@use "text-edit"; // text fields, areas, rich text (com.truesim.ui.controls.text)

// ------------------------------------------------------------------ palette: live tokens, dark by default

:root {
  --bg: #0d1117;
  --surface: rgba(#161b22, 0.86);
  --surface-raised: lighten(var(--surface), 5%);
  --edge: rgba(#8b949e, 0.28);
  --fg: #e6edf3;
  --fg-muted: #8b949e;
  --accent: #3fa7ff;
  --danger: #ff5c5c;
  --good: #3fb950;
  --track: rgba(#8b949e, 0.22);
  --shadow: rgba(black, 0.45);
  --outline: rgba(black, 0.55);
}

@tokens dark {
  --bg: #0d1117;
  --surface: rgba(#161b22, 0.86);
  --edge: rgba(#8b949e, 0.28);
  --fg: #e6edf3;
  --fg-muted: #8b949e;
  --accent: #3fa7ff;
  --danger: #ff5c5c;
  --good: #3fb950;
  --track: rgba(#8b949e, 0.22);
  --shadow: rgba(black, 0.45);
  --outline: rgba(black, 0.55);
}

@tokens light {
  --bg: #f6f8fa;
  --surface: rgba(white, 0.92);
  --edge: rgba(#1f2328, 0.16);
  --fg: #1f2328;
  --fg-muted: #59636e;
  --accent: #0969da;
  --danger: #cf222e;
  --good: #1a7f37;
  --track: rgba(#1f2328, 0.12);
  --shadow: rgba(#1f2328, 0.18);
  --outline: rgba(white, 0.6);
}

@tokens high-contrast {
  --bg: black;
  --surface: black;
  --edge: white;
  --fg: white;
  --fg-muted: #e0e0e0;
  --accent: #ffd700;
  --danger: #ff6b6b;
  --good: #7cff7c;
  --track: #5a5a5a;
  --shadow: rgba(black, 0);
  --outline: black;
}

// ------------------------------------------------------------------ panels

panel {
  layout: stack;
  direction: column;
  gap: tokens.$space-s;
  focus-ring-offset: 2px;
  @include reactive;

  &:disabled { opacity: 0.45; cursor: not-allowed; }
  &:focus-visible { focus-ring: 2px var(--accent); }
  &:drop-target { background: box(rgba(#3fa7ff, 0.18)); border: 1px var(--accent); }
  &:dragging { opacity: 0.55; }
}

// ------------------------------------------------------------------ layers

// A layer's root covers the screen; its children (pop-ups, tooltips, dialogs) sit at their offsets.
layer {
  layout: none;
}

// The HUD's root covers its layer. Only the root: the style name is inherited by unnamed panels inside it, which
// stack like any panel (as anchors filling the root they would all draw over one another).
root > panel.hud, layer > panel.hud {
  layout: anchors;
  anchors: full;
  padding: tokens.$space-xl;
}

panel.card {
  background: box(var(--surface));
  border: 1px var(--edge);
  radius: tokens.$radius-m;
  padding: tokens.$space-m tokens.$space-l;
  gap: space(1.5);
  @include raised(1);
  pointer-events: all; // a card is a surface: it takes the pointer (and shows :hover) even without listeners

  &:hover { background: box(var(--surface-raised)); }
}

panel.primary {
  background: box(var(--accent));
  radius: tokens.$radius-s;
  padding: tokens.$space-s tokens.$space-m;
  cursor: pointer;

  &:hover { background: box(lighten(var(--accent), 8%)); }
  &:pressed { scale: 0.97; background: box(darken(var(--accent), 6%)); }
  &:focused { border: 2px var(--fg); }
}

panel.danger {
  background: box(var(--danger));
  radius: tokens.$radius-s;
  padding: tokens.$space-s tokens.$space-m;
  cursor: pointer;
}

// a meter is a track; its child panel is the fill, sized by the control
panel.meter {
  layout: flex;
  direction: row;
  align-items: stretch;
  height: 8px;
  min-width: 80px;
  background: box(var(--track));
  clip: true; // the fill stays inside the rounded track
  @include pill(0, 0);

  > panel { background: box(var(--good)); radius: 999px; }
  > panel.danger { background: box(var(--danger)); padding: 0; }
  > panel.primary { background: box(var(--accent)); padding: 0; }
}

// ------------------------------------------------------------------ text

label {
  color: var(--fg);
  font-family: tokens.$font-ui;
  @include text(body);
  line-height: 1.3;
  text-align: start;

  &:disabled { opacity: 0.5; }
}

// HUD text floats over the game: an outline keeps it legible on any background
label.hud { text-outline: 1px var(--outline); }

label.title {
  @include text(title, 600);
}

label.value {
  font-family: tokens.$font-numbers;
  @include text(value, bold);
  text-align: end;
}

label.caption {
  color: var(--fg-muted);
  @include text(caption);
}

label.primary { color: var(--accent); }
label.danger { color: var(--danger); }
label.meter { @include text(caption, 600); color: var(--fg-muted); }

// labels on a filled button read on the accent colour
panel.primary label { color: contrast(#3fa7ff); }
panel.danger label { color: white; }

// ------------------------------------------------------------------ images

image {
  size: 24px;
  image: none;
}

image.title { size: 20px; }
image.caption { size: 14px; }
image.primary { size: 24px; }
image.danger { size: 24px; }
image.hud { size: 32px; }
image.value { size: 28px; }
image.card { size: 24px; }
image.meter { size: 12px; }

// ------------------------------------------------------------------ overlays, windows and docking (ui-controls)

@import "windows";
@import "oswindows"; // docking's OS windows
