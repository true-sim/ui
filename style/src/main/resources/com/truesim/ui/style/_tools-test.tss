// The garish test look of the developer tools (_tools.tss for the element types).

$hot: #ff00ff;
$lime: #39ff14;
$sun: #ffef00;
$cyan: #00ffff;

imm-window {
  layout: flex;
  direction: column;
  min-width: 340px;
  background: linear-gradient(135deg, #400040, #004040);
  border: 5px $sun;
  radius: 0 22px 0 22px;
  clip: true;
  pointer-events: all;
}
imm-title { layout: flex; direction: row-reverse; padding: 8px; background: box($hot); }
label.imm-title { font-size: 15px; line-height: 1.5; color: $lime; scale: 1; }
imm-window-body { layout: flex; direction: column; gap: 9px; padding: 13px; }
imm-line { layout: flex; direction: row-reverse; align-items: center; gap: 11px; }
imm-group { layout: flex; direction: column; gap: 7px; border: 2px $cyan; padding: 3px; }
imm-field { layout: flex; direction: row-reverse; align-items: center; gap: 9px; }
label.imm-text { font-size: 14px; line-height: 1.5; color: $cyan; scale: 1; }
label.imm-label { font-size: 13px; line-height: 1.5; color: $sun; scale: 1; }
label.imm-value { font-size: 13px; line-height: 1.4; color: black; text-outline: 0px black; scale: 1; text-align: center; }
imm-slider, imm-drag {
  layout: overlay;
  width: 150px;
  height: 28px;
  background: box($lime);
  border: 3px $hot;
  clip: true;
  &:focus-visible { focus-ring: 4px $sun; }
}
imm-slider-fill { background: box(#ff6600); }
textfield.imm { width: 150px; font-size: 14px; line-height: 1.4; padding: 2px 6px; }
imm-combo { layout: flex; direction: column; width: 150px; }
imm-combo-button {
  layout: flex;
  direction: row-reverse;
  align-items: center;
  height: 28px;
  padding: 0 6px;
  background: box($cyan);
  border: 3px $hot;
}
imm-combo-arrow { size: 10px; background: box($hot); }
imm-combo-list { layout: flex; direction: column; background: box($sun); padding: 4px; }
label.imm-combo-item { font-size: 13px; line-height: 1.4; color: black; text-outline: 0px black; scale: 1; &:selected { background: box($hot); } }
imm-tree { layout: flex; direction: column; }
imm-tree-header {
  layout: flex;
  direction: row-reverse;
  align-items: center;
  gap: 8px;
  background: box(#004000);
  > label { font-size: 13px; line-height: 1.5; scale: 1; }
}
imm-tree-arrow { size: 11px; background: box($sun); &:expanded { background: box($hot); } }
imm-tree-body { layout: flex; direction: column; padding: 0 0 0 26px; border: 2px $lime; }
imm-selectable { layout: flex; direction: row; padding: 2px 6px; background: box(#000060); > label { font-size: 13px; line-height: 1.5; scale: 1; } &:selected { background: box($hot); } }
imm-table { layout: flex; direction: column; grow: 1; border: 3px $cyan; }
imm-row { layout: flex; direction: row; background: box(#300030); }
imm-cell { layout: flex; direction: column; grow: 1; basis: 0px; padding: 4px; border: 1px $sun; }

debug-overlay { width: 100%; height: 100%; pointer-events: none; }
debug-windows, debug-blocker { layout: none; width: 100%; height: 100%; }
debug-bounds { border: 2px $cyan; }
debug-clip { border: 3px $hot; }
debug-grid { border: 1px $sun; }
debug-dirty { border: 3px $lime; background: box(rgba($lime, 0.3)); }
debug-hover { border: 3px #ff6600; background: box(rgba(#ff6600, 0.3)); }
debug-selected { border: 4px $sun; background: box(rgba($sun, 0.3)); }

imm-child { layout: flex; direction: column; grow: 1; clip: true; pointer-events: all; border: 3px $hot; }
imm-child-content { layout: flex; direction: column; gap: 5px; shrink: 0; }
