# A small sample of English affix rules for the true-sim UI toolkit's spell checker, written for this project
# (not derived from any third-party dictionary). Hunspell .aff format, the subset AffixRules reads.
# Replace en-sample.aff and en-sample.dic with a full dictionary (see docs/ui.md) for real use.
SET UTF-8
TRY esianrtolcdugmphbyfvkwzESIANRTOLCDUGMPHBYFVKWZ'
KEY qwertyuiop|asdfghjkl|zxcvbnm
NOSUGGEST !

# common misspellings: suggestions try these replacements first
REP 12
REP ie ei
REP ei ie
REP a e
REP e a
REP f ph
REP ph f
REP c s
REP s c
REP k c
REP teh the
REP recieve receive
REP alot a_lot

# plural nouns and third person verbs
SFX S Y 4
SFX S   y     ies        [^aeiou]y
SFX S   0     s          [aeiou]y
SFX S   0     es         [sxz]
SFX S   0     s          [^sxyz]

# nouns ending in ch or sh
SFX E Y 1
SFX E   0     es         h

# past tense and participle
SFX D Y 4
SFX D   0     d          e
SFX D   y     ied        [^aeiou]y
SFX D   0     ed         [aeiou]y
SFX D   0     ed         [^ey]

# present participle
SFX G Y 2
SFX G   e     ing        e
SFX G   0     ing        [^e]

# agent nouns and comparatives
SFX R Y 4
SFX R   0     r          e
SFX R   y     ier        [^aeiou]y
SFX R   0     er         [aeiou]y
SFX R   0     er         [^ey]

# superlatives
SFX T Y 4
SFX T   0     st         e
SFX T   y     iest       [^aeiou]y
SFX T   0     est        [aeiou]y
SFX T   0     est        [^ey]

# adverbs
SFX L Y 3
SFX L   0     ly         [^ley]
SFX L   y     ily        y
SFX L   le    ly         le

# nouns of quality
SFX P Y 2
SFX P   y     iness      [^aeiou]y
SFX P   0     ness       [^y]

# possessive
SFX M Y 1
SFX M   0     's         .

# negative prefix
PFX U Y 1
PFX U   0     un         .

# again
PFX A Y 1
PFX A   0     re         .
